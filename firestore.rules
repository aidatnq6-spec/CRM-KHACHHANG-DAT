rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.email == "ndat7289@gmail.com";
    }

    function ownsUserDoc(userId) {
      return isOwner() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if ownsUserDoc(userId);

      match /cksCustomers/{customerId} {
        allow read, create, update, delete: if ownsUserDoc(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
