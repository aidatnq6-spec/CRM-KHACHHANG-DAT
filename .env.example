# Có thể để trống để tiếp tục dùng cấu hình Firebase public trích từ bản HTML.
# Không đặt service-account key hoặc mật khẩu tài khoản vào biến NEXT_PUBLIC.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chỉ dành cho kiểm thử local; không hoạt động trong production.
# NEXT_PUBLIC_CRM_TEST_MODE=1
